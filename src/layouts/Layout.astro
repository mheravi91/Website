---
import "../styles/global.css";

type StructuredData = Record<string, unknown>;

interface Props {
  title: string;
  description?: string;
  favicon: string;
  thumbnail?: string;
  structuredData?: StructuredData | StructuredData[];
  socialTitle?: string;
  socialDescription?: string;
  socialImage?: string;
  socialImageAlt?: string;
  keywords?: string[] | string;
  robots?: string;
}

const {
  title,
  description,
  favicon,
  thumbnail,
  structuredData,
  socialTitle,
  socialDescription,
  socialImage,
  socialImageAlt,
  keywords: keywordsProp,
  robots: robotsProp,
} = Astro.props;

const DEFAULT_DESCRIPTION =
  "Doctoral researcher in automation and robotics focusing on physics-informed, data-driven modeling and reinforcement learning.";
const englishName = "Mohammad Heravi";
const persianName = "محمد هروی";
const englishFirstName = "Mohammad";
const englishLastName = "Heravi";
const authorNames = `${englishName} | ${persianName}`;
const DEFAULT_KEYWORDS = [
  englishName,
  persianName,
  "Mohammad Heravi Tampere University",
  "Automation Technology and Mechanical Engineering",
  "Physics-informed data-driven modeling",
  "Field robotics",
  "Industrial robotics",
  "Reinforcement learning",
  "Robotics research",
  "Autonomous excavation",
  "Control systems",
  "Tampere University doctoral researcher",
];

const metaDescription = (description ?? DEFAULT_DESCRIPTION).trim();

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";

const resolveAssetPath = (asset: string) =>
  asset.startsWith("/") || /^https?:\/\//i.test(asset) ? asset : prefix + asset;

const resolvedSiteUrl = Astro.site ? new URL(Astro.site) : undefined;
const currentUrl = Astro.url;
const baseForUrls = resolvedSiteUrl ?? currentUrl;

const canonicalUrl = (() => {
  if (baseForUrls && currentUrl)
    return new URL(currentUrl.pathname + currentUrl.search, baseForUrls).href;
  return currentUrl?.href;
})();

const makeAbsolute = (path?: string) => {
  if (!path) return undefined;
  if (/^https?:\/\//i.test(path)) return path;
  const normalized = path.startsWith("/") ? path : prefix + path;
  if (baseForUrls) return new URL(normalized, baseForUrls).href;
  if (currentUrl) return new URL(normalized, currentUrl).href;
  return normalized;
};

const guessMimeType = (url?: string) => {
  if (!url) return undefined;
  const lower = url.toLowerCase();
  if (lower.endsWith(".png")) return "image/png";
  if (lower.endsWith(".webp")) return "image/webp";
  if (lower.endsWith(".gif")) return "image/gif";
  return "image/jpeg";
};

const faviconPath = resolveAssetPath(favicon);
const absoluteFavicon = makeAbsolute(faviconPath);
const ogImageUrl = socialImage
  ? makeAbsolute(resolveAssetPath(socialImage))
  : thumbnail
    ? makeAbsolute(resolveAssetPath(thumbnail))
    : undefined;
const twitterImageAlt =
  socialImageAlt ?? (ogImageUrl ? `Preview image for ${englishName}` : undefined);
const homepageUrl = makeAbsolute("/");
const schemaOrigin = (() => {
  if (homepageUrl) return new URL(homepageUrl).origin;
  if (baseForUrls) return baseForUrls.origin;
  return "https://heravi.dev";
})();

const personId = `${schemaOrigin}/#mohammad-heravi`;
const websiteId = `${schemaOrigin}/#website`;
const tampereId = `${schemaOrigin}/#tampere-university`;
const departmentId = `${schemaOrigin}/#automation-technology-and-mechanical-engineering`;
const keywordsArray = Array.isArray(keywordsProp)
  ? keywordsProp
  : keywordsProp
    ? keywordsProp
        .split(",")
        .map((keyword) => keyword.trim())
        .filter(Boolean)
    : DEFAULT_KEYWORDS;
const keywordsContent = Array.from(new Set([...DEFAULT_KEYWORDS, ...keywordsArray]))
  .map((keyword) => keyword.trim())
  .filter(Boolean);
const keywordsString = keywordsContent.join(", ");
const robots = (robotsProp ?? "index,follow").trim();

const defaultStructuredData: StructuredData[] = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": personId,
    name: englishName,
    alternateName: [persianName, "Dr. Mohammad Heravi", "Mohammad Heravi PhD", "محمد هروی محقق"],
    url: homepageUrl ?? `${schemaOrigin}/`,
    image: `${schemaOrigin}/profile.jpg`,
    email: "mailto:contact@heravi.dev",
    jobTitle: "Doctoral Researcher",
    worksFor: { "@id": tampereId },
    affiliation: [
      { "@id": departmentId },
      { "@id": tampereId },
    ],
    knowsAbout: [
      "Physics-informed, data-driven modeling",
      "Robotics",
      "Control",
      "Excavation autonomy",
      "Reinforcement learning",
    ],
    knowsLanguage: ["en", "fa"],
    sameAs: [
      "https://heravi.dev",
      "https://scholar.google.com/citations?user=DYUEpmsAAAAJ&hl=en",
      "https://github.com/mheravi91",
      "https://orcid.org/0009-0007-2582-083X",
      "https://cal.com/heravi/",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": websiteId,
    url: homepageUrl ?? `${schemaOrigin}/`,
    name: englishName,
    alternateName: [persianName],
    description: metaDescription,
    inLanguage: "en-US",
    author: { "@id": personId },
    publisher: { "@id": personId },
    ...(keywordsString ? { keywords: keywordsString } : {}),
    potentialAction: {
      "@type": "SearchAction",
      target: `${schemaOrigin}/?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "CollegeOrUniversity",
    "@id": tampereId,
    name: "Tampere University",
    alternateName: ["Tampereen yliopisto"],
    url: "https://www.tuni.fi/en",
    sameAs: [
      "https://www.wikidata.org/wiki/Q1322419",
      "https://en.wikipedia.org/wiki/Tampere_University",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "@id": departmentId,
    name: "Automation Technology and Mechanical Engineering, Tampere University",
    parentOrganization: { "@id": tampereId },
  },
];

const userStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const normalizedStructuredData = [
  ...defaultStructuredData,
  ...userStructuredData,
];

const socialTitleCombined = socialTitle ?? title;
const socialDescriptionCombined = socialDescription ?? metaDescription;
const twitterTitle = socialTitleCombined;
const twitterDescription = socialDescriptionCombined.slice(0, 280);
const ogImageType = guessMimeType(ogImageUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={metaDescription} />
    {keywordsString && <meta name="keywords" content={keywordsString} />}
    <meta name="author" content={authorNames} />
    <meta name="creator" content={authorNames} />
    <meta property="profile:first_name" content={englishFirstName} />
    <meta property="profile:last_name" content={englishLastName} />
    <meta property="profile:username" content="mheravi91" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="light dark" />
    <meta name="application-name" content={englishName} />
    <meta name="apple-mobile-web-app-title" content={englishName} />
    <meta
      name="theme-color"
      content="#0f172a"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#020617"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content={Astro.generator} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href={faviconPath} />
    {absoluteFavicon && (
      <link rel="mask-icon" href={absoluteFavicon} color="#2563eb" />
    )}

    <meta property="og:title" content={socialTitleCombined} />
    <meta property="og:description" content={socialDescriptionCombined} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={englishName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="fa_IR" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && (
      <meta
        property="og:image:alt"
        content={twitterImageAlt}
      />
    )}
    {ogImageUrl && <meta property="og:image:secure_url" content={ogImageUrl} />}
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {twitterImageAlt && <meta name="twitter:image:alt" content={twitterImageAlt} />}
    <meta name="twitter:site" content="@mheravi91" />
    <meta name="twitter:creator" content="@mheravi91" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.15.1/dist/katex.css"
      integrity="sha384-WsHMgfkABRyG494OmuiNmkAOk8nhO1qE+Y6wns6v+EoNoTNxrWxYpl5ZYWFOLPCM"
      crossorigin="anonymous"
    />
    <script
      src="https://analytics.ahrefs.com/analytics.js"
      data-key="C/ZVuqzi1O7f6jyoZvXsVg"
      async
    />

    {normalizedStructuredData.map((schema) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(schema, null, 2)}
      />
    ))}

    <title>{title}</title>
  </head>
  <body
    class="flex flex-col [&>*]:mt-[1em] items-center pt-12 pb-6 w-full [&>*]:px-6 [&>*]:max-w-[60rem] [&>astro-island>*]:px-6 [&>astro-island>*]:max-w-[60rem] text-zinc-900 bg-zinc-50 dark:text-zinc-100 dark:bg-zinc-950"
  >
    <slot />
    <footer class="m-auto">
      <p class="text-zinc-500 dark:text-zinc-400 text-sm [&_a]:text-blue-500 dark:[&_a]:text-blue-300">
        Thanks to <a href="https://roman.technology" rel="noopener noreferrer">Roman Hauksson</a> for the original template —
        view the source on
        <a href="https://github.com/RomanHauksson/academic-project-astro-template">GitHub</a>.
        Licensed under <a href="http://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.
      </p>
    </footer>
  </body>
</html>
